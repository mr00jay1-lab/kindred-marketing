---
/**
 * /terms — Terms of Service placeholder page
 *
 * IMPORTANT: The canonical terms content lives in:
 *   mr00jay1-lab/kindred-legal  →  docs/terms_of_service.md
 *
 * Before going live, sync the content from that repo into this page.
 * The canonical URL /terms is referenced by:
 *   - App Store Connect
 *   - Play Console → Store listing
 *   - In-app About screen
 * DO NOT change this URL path.
 */
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Base
  title="Terms of Service — Kindred"
  description="Kindred terms of service."
  canonicalUrl="https://kindredhome.app/terms"
>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="legal-header">
    <div class="container">
      <a href="/" class="legal-header__back" aria-label="Back to Kindred home">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        Kindred
      </a>
    </div>
  </header>

  <main id="main-content" class="legal-page section" tabindex="-1">
    <div class="container legal-page__inner">
      <h1 class="display legal-page__title">Terms of Service</h1>

      <!--
        ╔══════════════════════════════════════════════════════════════════╗
        ║  TODO — OWNER ACTION REQUIRED BEFORE LAUNCH                     ║
        ║                                                                  ║
        ║  Replace this placeholder block with the actual Terms of Service ║
        ║  content from:                                                   ║
        ║    mr00jay1-lab/kindred-legal/docs/terms_of_service.md          ║
        ║                                                                  ║
        ║  Steps:                                                          ║
        ║  1. Copy the Markdown from kindred-legal/docs/terms_of_service.md║
        ║  2. Either convert to HTML and paste below, OR add kindred-legal ║
        ║     as a git submodule and import with Astro MDX.               ║
        ║  3. Verify the page renders at https://kindredhome.app/terms    ║
        ║  4. Cross-check the URL still matches App Store + Play Console. ║
        ╚══════════════════════════════════════════════════════════════════╝
      -->

      <div class="legal-page__placeholder">
        <p class="body-copy">
          This page will contain the full Kindred Terms of Service, synced from
          the <a href="https://github.com/mr00jay1-lab/kindred-legal" rel="noopener">kindred-legal</a> repository
          before the site goes live.
        </p>
        <p class="body-copy" style="margin-top: 1rem;">
          Questions? Email us at
          <a href="mailto:support@kindredhome.app">support@kindredhome.app</a>.
        </p>
      </div>

    </div>
  </main>

  <Footer />
</Base>

<style>
.skip-link {
  position: absolute; top: -999px; left: 0;
  background: var(--color-primary); color: #fff;
  padding: 0.75rem 1.25rem; font-weight: 600;
  text-decoration: none; border-radius: 0 0 var(--radius-sm) 0; z-index: 9999;
}
.skip-link:focus { top: 0; outline: none; }

.legal-header {
  padding-block: 1.25rem;
  border-bottom: 1px solid var(--color-divider);
  background: var(--color-surface);
}
.legal-header__back {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  font-size: var(--text-body-s-size);
  font-weight: 600;
  color: var(--color-primary);
  text-decoration: none;
  transition: opacity var(--motion-standard) var(--motion-curve);
}
.legal-header__back:hover { opacity: 0.75; }

.legal-page__inner {
  max-width: 720px;
}
.legal-page__title {
  margin-bottom: 2rem;
}
.legal-page__placeholder {
  background: var(--color-surface-soft);
  border: 1px dashed var(--color-divider);
  border-radius: var(--radius-md);
  padding: 2rem;
}
.legal-page__placeholder a {
  color: var(--color-primary);
  text-decoration: underline;
  text-underline-offset: 2px;
}
</style>

---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import '../../styles/global.css';
import '../../styles/site.css';
---

<Base
  title="Join a Kindred household"
  description="You've been invited to join a household on Kindred — the household OS."
  noindex={true}
>
  <main class="join band band--cream" id="main-content" tabindex="-1">
    <div class="band__inner join__inner">
      <h1 class="h2">You've been invited to&nbsp;Kindred</h1>

      <p class="join__lead">
        Someone wants you to join their household on Kindred — the household OS.
      </p>

      <div class="join__code-block" id="join-code-block" hidden>
        <p class="label">Your invite code</p>
        <p class="join__code" id="join-code"></p>
        <p class="body-s">
          Open Kindred, tap <strong>Join a household</strong>, and enter this code.
        </p>
      </div>

      <section class="join__download">
        <h2 class="title-m">Don't have Kindred yet?</h2>
        <StoreBadges variant="hero" />
        <p class="body-s">
          After installing, tap your invite link again — the app will open it directly.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</Base>

<script>
  const code = new URLSearchParams(window.location.search).get('code');
  if (code) {
    const block = document.getElementById('join-code-block');
    const codeEl = document.getElementById('join-code');
    if (block && codeEl) {
      codeEl.textContent = code;
      block.hidden = false;
    }
  }
</script>

<style>
  .join {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  .join__inner {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .join__lead {
    font-size: var(--text-lead);
    line-height: var(--lh-normal);
    color: var(--color-ink-soft);
    max-width: 48ch;
  }
  .join__code-block {
    border: 1px solid var(--color-divider);
    background: var(--color-bg-soft);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .join__code {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    word-break: break-all;
  }
  .join__download {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>

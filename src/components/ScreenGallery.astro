---
// Real-screenshot gallery, dark-primary, with a Light/Dark toggle that swaps
// the two frames that have a light twin (calendar-week→month, shopping).
const frames = [
  { dark: '/images/01_calendar_week.png', light: '/images/09_calendar_month.png', cap: 'The week at a glance' },
  { dark: '/images/02_calendar_day.png', cap: 'A single day, in detail' },
  { dark: '/images/08_shopping_list.png', light: '/images/05_shopping_list.png', cap: 'The shared shopping list' },
  { dark: '/images/09_stock_list.png', cap: 'Your stock, tracked' },
  { dark: '/images/11_chores_list.png', cap: 'Today’s chores, sorted' },
  { dark: '/images/19_plan_next_week.png', cap: 'AI plans the week' },
  { dark: '/images/03_recipe_create_with_ai.png', cap: 'Create a recipe with AI' },
  { dark: '/images/13_household_availability.png', cap: 'Who’s around this week' },
];
---
<section class="band band--cream" aria-labelledby="gallery-h">
  <div class="band__inner">
    <div class="gallery__head">
      <div class="intro intro--left reveal">
        <span class="eyebrow" style="--accent: var(--color-primary)">See it before you download</span>
        <h2 id="gallery-h" class="h2">Real screens, not mock-ups.</h2>
        <p class="lead">This is exactly what you’ll open — straight from the app, no stock photos.</p>
      </div>
      <div class="toggle reveal" role="group" aria-label="Theme preview" data-gallery-toggle>
        <button type="button" data-theme-btn="dark" aria-pressed="true">Dark</button>
        <button type="button" data-theme-btn="light" aria-pressed="false">Light</button>
      </div>
    </div>

    <div class="gallery__grid">
      {frames.map((f) => (
        <figure class="gframe reveal">
          <div class="phone phone--gallery">
            <div class="phone__screen">
              <img
                src={f.dark}
                data-dark={f.dark}
                data-light={f.light ?? f.dark}
                alt={f.cap}
                width="1179" height="2556" loading="lazy"
              />
            </div>
          </div>
          <figcaption class="gframe__cap">{f.cap}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  const toggle = document.querySelector('[data-gallery-toggle]');
  if (toggle) {
    const btns = toggle.querySelectorAll('[data-theme-btn]');
    const imgs = document.querySelectorAll('.gallery__grid img');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-theme-btn');
        btns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        imgs.forEach((img) => {
          const next = img.getAttribute(mode === 'light' ? 'data-light' : 'data-dark');
          if (next) img.setAttribute('src', next);
        });
      });
    });
  }
</script>

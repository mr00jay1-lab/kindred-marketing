---
// Screen gallery — 4 phone-frame placeholders with captions
// Replace placeholder divs with real screenshots before launch.
const screens = [
  {
    id: 'gallery-1',
    caption: 'Weekly calendar — tap any slot to plan a meal.',
    altText: 'Kindred weekly calendar showing meal slots for the week ahead',
    slot: 'calendar',
    accentColor: '#001A57', // navy
  },
  {
    id: 'gallery-2',
    caption: 'Add a meal in two taps — the form expands only when you want it.',
    altText: 'Kindred add-meal form in progressive disclosure mode',
    slot: 'capture',
    accentColor: '#5F7363', // sage
  },
  {
    id: 'gallery-3',
    caption: 'Plan Next Week — AI drafts the week from your stock in seconds.',
    altText: 'Kindred Plan Next Week AI suggestion screen',
    slot: 'ai',
    accentColor: '#2BB98B', // teal
  },
  {
    id: 'gallery-4',
    caption: 'Shopping list builds itself from what you\'re actually missing.',
    altText: 'Kindred shopping list automatically populated from planned meals and stock',
    slot: 'shopping',
    accentColor: '#C76B4B', // terracotta
  },
] as const;
---

<section class="gallery section" aria-labelledby="gallery-heading">
  <div class="container">
    <h2 id="gallery-heading" class="headline gallery__heading">
      See it in action.
    </h2>

    <div class="gallery__grid" role="list">
      {screens.map((screen) => (
        <figure class="gallery__item" role="listitem">
          <!--
            TODO: replace placeholder below with a real screenshot.
            Asset: public/images/screenshot-{screen.slot}.png
            Dimensions: 390 × 844 logical px, exported @2x from iOS simulator
            Then swap the placeholder div for:
            <img
              src={`/images/screenshot-${screen.slot}.png`}
              alt={screen.altText}
              width="195" height="422"
              loading="lazy"
              decoding="async"
              class="gallery__screenshot"
            />
          -->
          <div
            class="gallery__placeholder"
            role="img"
            aria-label={screen.altText}
            style={`--accent: ${screen.accentColor};`}
          >
            <div class="gallery__placeholder-inner">
              <div class="gallery__placeholder-dot" style={`background: ${screen.accentColor};`} />
              <p class="gallery__placeholder-label">App screenshot</p>
              <p class="gallery__placeholder-sublabel">{screen.slot}</p>
            </div>
          </div>
          <figcaption class="gallery__caption body-s">{screen.caption}</figcaption>
        </figure>
      ))}
    </div>

    <!-- Trust badge row -->
    <div class="gallery__trust" aria-label="Trust signals">
      <span class="gallery__trust-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Built in the UK
      </span>
      <span class="gallery__trust-sep" aria-hidden="true">·</span>
      <span class="gallery__trust-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        Privacy-first
      </span>
      <span class="gallery__trust-sep" aria-hidden="true">·</span>
      <span class="gallery__trust-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
        </svg>
        No ads, ever
      </span>
    </div>
  </div>
</section>

<style>
.gallery__heading {
  text-align: center;
  margin-bottom: 2.5rem;
}

/* ── Phone grid ──────────────────────────────────────────────────────────── */
.gallery__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.25rem;
  margin-bottom: 3rem;
}

@media (min-width: 640px) {
  .gallery__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.gallery__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
}

/* Phone frame wrapper */
.gallery__placeholder,
.gallery__screenshot {
  width: 100%;
  aspect-ratio: 9 / 19.5;
  background: #1A1815;
  border-radius: 28px;
  overflow: hidden;
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.07),
    0 12px 32px rgba(0,0,0,0.28);
  position: relative;
}

.gallery__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery__placeholder::before {
  content: '';
  position: absolute;
  top: 8px;
  left: 50%;
  transform: translateX(-50%);
  width: 44px;
  height: 7px;
  background: #1A1815;
  border-radius: 10px;
  z-index: 2;
}

.gallery__placeholder-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.375rem;
  background: var(--color-bg);
  width: calc(100% - 10px);
  height: calc(100% - 10px);
  border-radius: 22px;
  justify-content: center;
  padding: 1rem;
}

.gallery__placeholder-dot {
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  opacity: 0.85;
}

.gallery__placeholder-label {
  font-size: 0.6rem;
  font-weight: 600;
  color: var(--color-ink-soft);
  text-align: center;
}
.gallery__placeholder-sublabel {
  font-size: 0.55rem;
  color: var(--color-ink-faint);
  text-align: center;
}

.gallery__caption {
  text-align: center;
  max-width: 22ch;
  color: var(--color-ink-soft);
  font-size: 0.75rem;
}

/* ── Trust badges ────────────────────────────────────────────────────────── */
.gallery__trust {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.625rem;
}

.gallery__trust-item {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  font-size: var(--text-body-s-size);
  color: var(--color-ink-faint);
  font-weight: 500;
}

.gallery__trust-sep {
  color: var(--color-divider);
  font-size: 1.25rem;
  line-height: 1;
}
</style>

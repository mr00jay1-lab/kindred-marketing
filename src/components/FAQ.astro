---
// FAQ — native <details> (no-JS resilient) + FAQPage JSON-LD for rich results.
const faqs = [
  { q: 'Does Kindred work on iPhone and Android?', a: 'Yes — it’s a native app on both, with everything kept in sync across your household’s phones. iPad and Android tablets are supported in portrait; landscape is on the way.' },
  { q: 'Is there a free version?', a: 'Yes. The free tier runs one shared household with unlimited meals, shopping lists, chores and recipes — no credit card, no time limit. Premium only adds the AI extras (meal planning, recipe extraction and images) and priority sync.' },
  { q: 'Do my partner or family need their own subscriptions?', a: 'No. One Premium covers your whole household. Invite anyone you live with — they sign in free and you pay once. It’s built for 2–4 people sharing a home.' },
  { q: 'How does the AI meal planner work?', a: 'Tap Plan Next Week and Kindred reads what’s already in your stock, what your household has actually eaten, and any dietary notes you’ve set — then drafts a week. You approve it, shuffle a night, or regenerate. If a draft fails or you don’t like it, the AI credit comes back.' },
  { q: 'Is my household data private?', a: 'Yes. Your data is yours, stored on Google Cloud in the UK/EU region. We don’t sell it, we don’t show ads against it, and we don’t use it to train AI. The full details are in our Privacy Policy.' },
  { q: 'Do you use my data to train AI?', a: 'No. Your household’s meals, lists and notes are never used to train any AI model. The AI features read your data only to draft your own week or tidy a recipe you’ve added — nothing leaves to train a model.' },
  { q: 'What happens to my data if I cancel?', a: 'Nothing is lost. Your meals, lists, recipes and chores stay in your account. You simply drop to Free — the full app minus the AI extras. Re-subscribe any time and the AI features switch back on with your data intact.' },
  { q: 'Can I cancel any time?', a: 'Yes — through the App Store or Google Play, in one tap. No retention call, no email loops, no hoops. You keep the free app for as long as you like.' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<section class="band band--soft" id="faq" aria-labelledby="faq-h">
  <div class="band__inner">
    <div class="intro reveal">
      <h2 id="faq-h" class="h2">Questions, answered.</h2>
    </div>

    <div class="faq__list">
      {faqs.map((f) => (
        <details class="faq__row reveal">
          <summary>{f.q}</summary>
          <p class="faq__a">{f.a}</p>
        </details>
      ))}
    </div>

    <p class="faq__close reveal">Still deciding? The free tier is the best way to see — download below.</p>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline></script>

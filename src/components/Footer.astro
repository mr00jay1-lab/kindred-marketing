---
import StoreBadges from './StoreBadges.astro';
---
<footer class="footer" role="contentinfo">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__brand">
        <div class="footer__brand-name">Kindred</div>
        <p class="footer__tagline">One calm place for your shared meals, shopping and chores.</p>
        <p class="footer__copy">© 2026 Kindred. <span class="dot" aria-hidden="true"></span> Made in the UK.</p>
      </div>
      <nav class="footer__links" aria-label="Footer">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/features">Features</a>
        <a href="mailto:support@kindredhome.app" aria-label="Email Kindred support">Support</a>
      </nav>
    </div>
    <div class="footer__bottom">
      <StoreBadges variant="footer" />
      <a href="https://postyourstartup.co/startup/kindred?ref=badge" class="footer__badge" target="_blank" rel="noopener noreferrer">
        <img src="https://postyourstartup.co/api/badge/kindred?theme=light" alt="Featured on PostYourStartup" width="212" height="55" loading="lazy" />
      </a>
      <a href="https://www.producthunt.com/products/kindred-family-hub?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-kindred-family-hub" class="footer__badge" target="_blank" rel="noopener noreferrer">
        <img src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1184700&theme=light" alt="Kindred - Family Hub - One calm home for your family's meals, shopping & chores | Product Hunt" width="250" height="54" loading="lazy" />
      </a>
    </div>
  </div>
</footer>

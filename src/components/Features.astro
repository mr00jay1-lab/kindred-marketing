---
// Feature cards — 3 differentiating mechanics
const features = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="3"/>
      <line x1="8" y1="2" x2="8" y2="6"/>
      <line x1="16" y1="2" x2="16" y2="6"/>
      <line x1="3" y1="10" x2="21" y2="10"/>
      <circle cx="12" cy="16" r="1.5" fill="currentColor" stroke="none"/>
    </svg>`,
    title: "Capture the meal, not the form.",
    body: "Tap a slot, pick the meal — done. No dropdowns for time-of-day, no clock-time field, no required tags. The form opens up only when you want it to.",
    accent: 'teal',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2L2 7l10 5 10-5-10-5z"/>
      <path d="M2 17l10 5 10-5"/>
      <path d="M2 12l10 5 10-5"/>
    </svg>`,
    title: "Plan next week in 30 seconds.",
    body: "Hit Plan Next Week, get an AI draft built from what's in your stock and what your household actually eats. Refused? You get the credit back — no charge for misses.",
    accent: 'primary',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <path d="M16 10a4 4 0 0 1-8 0"/>
    </svg>`,
    title: "Your stock, your shop, in sync.",
    body: "Mark an item skipped at the shop and Kindred remembers — it comes back next week, not lost. Add a recipe and the shopping list builds itself from what you're actually missing.",
    accent: 'coral',
  },
] as const;
---

<section class="features section" aria-labelledby="features-heading">
  <div class="container">
    <h2 id="features-heading" class="headline features__heading">
      Everything to run your shared home.
    </h2>

    <div class="features__grid">
      {features.map((f) => (
        <article class={`feature-card feature-card--${f.accent}`}>
          <div class={`feature-card__icon feature-card__icon--${f.accent}`} set:html={f.icon} />
          <h3 class="title-m feature-card__title">{f.title}</h3>
          <p class="body-copy feature-card__body">{f.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.features__heading {
  margin-bottom: 2.5rem;
  text-align: center;
}

.features__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
}

@media (min-width: 640px) {
  .features__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

/* ── Feature card ────────────────────────────────────────────────────────── */
.feature-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: var(--card-padding-v) var(--card-padding-h);
  box-shadow: var(--shadow-2);
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
  border: 1px solid var(--color-divider);
  transition: transform var(--motion-standard) var(--motion-curve),
              box-shadow var(--motion-standard) var(--motion-curve);
}
.feature-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}

/* Icon well */
.feature-card__icon {
  width: 2.75rem;
  height: 2.75rem;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.feature-card__icon svg {
  width: 1.375rem;
  height: 1.375rem;
}

.feature-card__icon--teal    { background: #E2F4EE; color: #1F8A6B; }
.feature-card__icon--primary { background: var(--color-primary-wash); color: var(--color-primary); }
.feature-card__icon--coral   { background: #FDEEE6; color: #C76B4B; }

.feature-card__title {
  line-height: var(--line-height-snug);
}
.feature-card__body {
  font-size: var(--text-body-s-size);
  margin: 0;
}
</style>

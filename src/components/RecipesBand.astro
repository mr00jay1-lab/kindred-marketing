---
import PhoneFrame from './PhoneFrame.astro';
const frames = [
  { src: '/images/03_recipe_create_with_ai.png', cap: 'Name it — AI writes it' },
  { src: '/images/04_recipe_edit_steps.png', cap: 'Clean, structured steps' },
  { src: '/images/07_ai_image_confirm_daily_cap.png', cap: 'A photo, generated' },
];
---
<section class="band band--soft" id="recipes" style="--accent: var(--color-teal-deep)" aria-labelledby="recipes-h">
  <div class="band__inner">
    <div class="intro reveal">
      <h2 id="recipes-h" class="h2">Your recipe box, with a little magic.</h2>
      <p class="lead">Type a name, paste a link, or snap a photo — and let Kindred do the fiddly bits: writing out ingredients, the steps, even the picture.</p>
    </div>

    <div class="recipes__grid">
      <article class="rcard rcard--ai reveal">
        <span class="fcard__eyebrow" style="--accent: var(--color-teal-deep)">✨ AI</span>
        <h3 class="rcard__title">Name it — Kindred writes the recipe</h3>
        <p class="rcard__body">Type just a dish name — “chicken katsu curry”, “Grandma’s lasagne” — and the AI drafts the whole thing: ingredients, quantities and steps, ready to cook or tweak.</p>
      </article>
      <article class="rcard rcard--ai reveal">
        <span class="fcard__eyebrow" style="--accent: var(--color-teal-deep)">✨ AI</span>
        <h3 class="rcard__title">Paste a link, get a recipe</h3>
        <p class="rcard__body">Drop in a URL and Kindred’s AI pulls the recipe into clean, structured form — no copy-pasting from between the ads and the life story.</p>
      </article>
      <article class="rcard rcard--ai reveal">
        <span class="fcard__eyebrow" style="--accent: var(--color-teal-deep)">✨ AI</span>
        <h3 class="rcard__title">Recipes that look the part</h3>
        <p class="rcard__body">No photo for a recipe? Kindred can generate a tasteful image so your recipe box looks as good as it cooks.</p>
      </article>
      <article class="rcard reveal">
        <h3 class="rcard__title">Save what you cook</h3>
        <p class="rcard__body">Your own recipes with photos, ingredients and steps — the dinners your household comes back to, all in one place.</p>
      </article>
    </div>

    <div class="recipes__frames">
      {frames.map((f) => (
        <figure class="gframe reveal">
          <PhoneFrame src={f.src} alt={f.cap} variant="small" />
          <figcaption class="gframe__cap">{f.cap}</figcaption>
        </figure>
      ))}
    </div>

    <p class="recipes__note reveal">
      <span class="ktag ktag--teal">Type-a-name, link import &amp; images use AI credits — included with Premium, topped up any time for £1.99</span>
    </p>
    <p class="recipes__more reveal"><a class="btn-link" href="/features">See every feature →</a></p>
  </div>
</section>

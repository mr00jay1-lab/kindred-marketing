---
import StoreBadges from './StoreBadges.astro';
const premium = ['AI meal planning', 'AI recipe extraction', 'AI recipe images', 'Priority sync'];
---
<section class="band band--cream" id="pricing" aria-labelledby="pricing-h">
  <div class="band__inner">
    <div class="intro reveal">
      <h2 id="pricing-h" class="h2">Simple pricing. One household, one price.</h2>
      <p class="lead">Start free. Add the AI when you’d rather it did the planning.</p>
    </div>

    <div class="pricing__grid">
      <article class="pcard reveal">
        <div class="pcard__name">Free</div>
        <div class="pcard__price">£0</div>
        <p class="pcard__desc">Everything you need to run one shared household — unlimited meals, shopping lists, chores and recipes. No credit card. For couples and families who want the rhythm without the AI extras.</p>
      </article>

      <article class="pcard pcard--premium reveal">
        <div class="pcard__ribbon">Best value — save 33%</div>
        <div class="pcard__name">Premium</div>
        <div class="pcard__price">£4.99<span class="per"> /month</span></div>
        <div class="pcard__year">or £39.99/year — 14-day free trial on annual</div>
        <ul class="pcard__list">
          {premium.map((f) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <p class="pcard__sub">Need more AI? Top up £1.99 any time. One Premium covers your whole household.</p>
        <StoreBadges variant="pricing" />
      </article>
    </div>

    <p class="pricing__note reveal">
      The App Store and Google Play show your local currency at checkout. Cancel any time, in one tap — no retention calls, no email loops.
    </p>
  </div>
</section>

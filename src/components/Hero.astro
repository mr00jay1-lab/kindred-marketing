---
import PhoneFrame from './PhoneFrame.astro';
import StoreBadges from './StoreBadges.astro';
---
<section class="hero" aria-labelledby="hero-headline">
  <img src="/images/hero-accent.png" alt="" aria-hidden="true" class="hero__accent" />
  <div class="hero__inner">
    <div class="hero__copy reveal">
      <h1 id="hero-headline" class="hero__title">
        Plan the <span class="accent-word">week</span> your household actually lives.
      </h1>
      <p class="hero__lead">
        Kindred turns shared meals, the shopping list, and whose-turn-is-it into one
        calm weekly rhythm. Built for couples and families who'd rather get on with their evening.
      </p>
      <StoreBadges variant="hero" />
      <p class="hero__price">Free to try. Premium £4.99/month or £39.99/year, with a 14-day trial.</p>
    </div>

    <div class="hero__visual">
      <div class="hero__frame-wrap">
        <PhoneFrame
          src="/images/01_calendar_week.png"
          alt="Kindred weekly calendar — colour-coded meal slots with member dots showing who's around"
          variant="hero"
          eager={true}
        />
        <span class="confetti confetti--teal" aria-hidden="true">✨ Plan next week</span>
        <span class="confetti confetti--coral" aria-hidden="true">● Who's eating</span>
      </div>
    </div>
  </div>
</section>

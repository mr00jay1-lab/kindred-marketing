---
// Hero section — above the fold, one viewport.
// Phone mockup is a placeholder until the owner drops in a real screenshot.
---

<section class="hero" aria-labelledby="hero-headline">
  <div class="container hero__inner">

    <div class="hero__copy">
      <h1 id="hero-headline" class="display hero__headline">
        Plan the week your household actually lives.
      </h1>

      <p class="body-copy hero__sub">
        Kindred turns shared meals, the shopping list, and&nbsp;"whose turn is&nbsp;it"
        into one calm weekly rhythm. Built for couples and families who'd rather
        get on with their evening.
      </p>

      <div class="hero__badges" role="group" aria-label="Download Kindred">
        <!-- App Store badge — official Apple spec SVG inline representation -->
        <a
          href="#"
          class="badge-link"
          aria-label="Download on the App Store"
          rel="noopener"
        >
          <!-- TODO: replace href="#" with the live App Store URL before launch -->
          <svg
            class="badge badge--apple"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 120 40"
            role="img"
            aria-label="Download on the App Store"
          >
            <rect width="120" height="40" rx="7" fill="#000"/>
            <text x="60" y="15" text-anchor="middle" fill="#fff" font-family="'Inter',sans-serif" font-size="7" font-weight="400">Download on the</text>
            <text x="60" y="28" text-anchor="middle" fill="#fff" font-family="'Inter',sans-serif" font-size="13" font-weight="600">App Store</text>
            <!-- Apple logo mark -->
            <path d="M14 12.5c0-2.1 1.7-3.1 1.8-3.2-1-1.5-2.5-1.7-3-1.7-1.3-.1-2.5.8-3.1.8-.7 0-1.7-.7-2.8-.7-1.4 0-2.8.8-3.5 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.6 2.2 2.7 2.2 1.1 0 1.5-.7 2.8-.7 1.3 0 1.7.7 2.8.7 1.2 0 2-1.1 2.7-2.1.8-1.2 1.2-2.3 1.2-2.4 0 0-2.7-1-2.7-3.5zm-2.5-6.4c.6-.7 1-1.7.9-2.6-.8 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.5.9.1 1.9-.4 2.5-1.2z" fill="#fff" transform="translate(0, 4) scale(1.1)"/>
          </svg>
        </a>

        <!-- Google Play badge — official Google spec SVG inline representation -->
        <a
          href="#"
          class="badge-link"
          aria-label="Get it on Google Play"
          rel="noopener"
        >
          <!-- TODO: replace href="#" with the live Google Play URL before launch -->
          <svg
            class="badge badge--play"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 135 40"
            role="img"
            aria-label="Get it on Google Play"
          >
            <rect width="135" height="40" rx="7" fill="#000"/>
            <text x="68" y="15" text-anchor="middle" fill="#fff" font-family="'Inter',sans-serif" font-size="7" font-weight="400">GET IT ON</text>
            <text x="68" y="29" text-anchor="middle" fill="#fff" font-family="'Inter',sans-serif" font-size="13" font-weight="600">Google Play</text>
            <!-- Play store triangle mark (simplified) -->
            <polygon points="10,10 10,30 22,20" fill="#4CAF50"/>
            <polygon points="10,10 22,20 16,13" fill="#81C784"/>
            <polygon points="22,20 10,30 16,27" fill="#F44336"/>
            <polygon points="22,20 16,13 16,27" fill="#FFD740"/>
          </svg>
        </a>
      </div>

      <p class="body-s hero__pricing-note">
        Free to try. Premium £4.99/month or £39.99/year with a 14-day trial.
      </p>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <!-- Phone mockup placeholder — replace with real iPhone frame + Calendar
           slot-board screenshot (PNG, @2x, ~390×844px) before launch.
           Recommended: static phone-only on cream/white. -->
      <div class="phone-mockup" role="img" aria-label="Kindred app — Calendar weekly slot-board">
        <div class="phone-mockup__screen">
          <div class="phone-mockup__placeholder">
            <!-- TODO: replace this placeholder with the real app screenshot.
                 Suggested asset: Calendar slot-board with presence dots
                 from the iOS simulator or TestFlight build.
                 Target dimensions: 390 × 844px (iPhone 14 Pro logical px).
                 Export as PNG @2x → public/images/screenshot-calendar.png
                 Then replace this div with:
                 <img src="/images/screenshot-calendar.png"
                      alt="Kindred app weekly calendar showing meals planned for the week"
                      width="390" height="844" loading="eager" />
            -->
            <div class="mockup-content">
              <div class="mockup-header">
                <div class="mockup-wordmark">Kindred</div>
                <div class="mockup-week">This week</div>
              </div>
              <div class="mockup-slots">
                <div class="mockup-day">
                  <span class="mockup-day__label">Mon</span>
                  <div class="mockup-slot mockup-slot--dinner">Pasta Arrabbiata</div>
                </div>
                <div class="mockup-day">
                  <span class="mockup-day__label">Tue</span>
                  <div class="mockup-slot mockup-slot--dinner">Thai Green Curry</div>
                </div>
                <div class="mockup-day">
                  <span class="mockup-day__label">Wed</span>
                  <div class="mockup-slot mockup-slot--empty">+ Add meal</div>
                </div>
                <div class="mockup-day">
                  <span class="mockup-day__label">Thu</span>
                  <div class="mockup-slot mockup-slot--dinner">Roast Chicken</div>
                </div>
                <div class="mockup-day">
                  <span class="mockup-day__label">Fri</span>
                  <div class="mockup-slot mockup-slot--dinner">Fish Tacos</div>
                </div>
              </div>
              <div class="mockup-fab">＋</div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
/* ── Hero layout ─────────────────────────────────────────────────────────── */
.hero {
  padding-block: clamp(3.5rem, 8vw, 6rem) clamp(3rem, 6vw, 5rem);
  background-color: var(--color-bg);
  overflow: hidden;
}

.hero__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  align-items: center;
}

@media (min-width: 768px) {
  .hero__inner {
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
}

/* ── Copy block ──────────────────────────────────────────────────────────── */
.hero__headline {
  margin-bottom: 1.25rem;
  max-width: 18ch;
}

.hero__sub {
  margin-bottom: 2rem;
  max-width: 42ch;
}

/* ── Store badges ────────────────────────────────────────────────────────── */
.hero__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.badge-link {
  display: inline-flex;
  border-radius: 7px;
  overflow: hidden;
  transition: opacity var(--motion-standard) var(--motion-curve),
              transform var(--motion-standard) var(--motion-curve);
  /* ensure 48px tap target height */
  min-height: 40px;
}
.badge-link:hover { opacity: 0.85; transform: translateY(-1px); }
.badge-link:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 3px;
  border-radius: 9px;
}

.badge {
  height: 40px;
  width: auto;
}
.badge--apple  { width: 120px; }
.badge--play   { width: 135px; }

.hero__pricing-note {
  margin-top: 0.25rem;
}

/* ── Phone mockup ────────────────────────────────────────────────────────── */
.hero__visual {
  display: flex;
  justify-content: center;
  order: -1; /* phone above copy on mobile */
}

@media (min-width: 768px) {
  .hero__visual {
    order: 1;
    justify-content: flex-end;
  }
}

.phone-mockup {
  position: relative;
  width: min(280px, 80vw);
  aspect-ratio: 9 / 19.5;
  background: #1A1815;
  border-radius: 44px;
  padding: 14px;
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.08),
    0 20px 60px rgba(0,0,0,0.35),
    0 8px 20px rgba(0,0,0,0.2);
}

/* Dynamic island notch */
.phone-mockup::before {
  content: '';
  position: absolute;
  top: 12px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 10px;
  background: #1A1815;
  border-radius: 10px;
  z-index: 2;
}

.phone-mockup__screen {
  width: 100%;
  height: 100%;
  border-radius: 32px;
  overflow: hidden;
  background: var(--color-bg);
}

.phone-mockup__placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.mockup-content {
  padding: 2.5rem 0.75rem 0.75rem;
  display: flex;
  flex-direction: column;
  height: 100%;
  gap: 0.5rem;
}

.mockup-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 0.5rem;
}
.mockup-wordmark {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-ink);
}
.mockup-week {
  font-size: 0.625rem;
  color: var(--color-ink-faint);
}

.mockup-slots {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  flex: 1;
}

.mockup-day {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.mockup-day__label {
  font-size: 0.6rem;
  font-weight: 600;
  color: var(--color-ink-faint);
  width: 1.75rem;
  flex-shrink: 0;
}

.mockup-slot {
  flex: 1;
  padding: 0.3rem 0.5rem;
  border-radius: var(--radius-sm);
  font-size: 0.6rem;
  font-weight: 500;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.mockup-slot--dinner {
  background: var(--color-navy);
}
.mockup-slot--empty {
  background: var(--color-surface-soft);
  color: var(--color-primary);
  border: 1px dashed var(--color-primary);
}

.mockup-fab {
  align-self: flex-end;
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  font-weight: 300;
  box-shadow: var(--shadow-fab);
  margin-bottom: 0.25rem;
}
</style>

---
// App Store + Google Play badges. variant: hero | pricing | footer | final.
// NOTE: hrefs are placeholders (#) until the public store URLs exist — the apps
// are on TestFlight + Play Internal pre-launch. Swap in real links + official
// Apple/Google artwork before public launch (these inline SVGs approximate them).
export interface Props {
  variant?: string;
  center?: boolean;
}
const { variant = 'hero', center = false } = Astro.props;
const cls = `badges badges--${variant}${center ? ' badges--center' : ''}`;
---
<div class={cls} role="group" aria-label="Download Kindred">
  <a href="#" class="badge-link" aria-label="Download on the App Store" rel="noopener"
     data-analytics={`store-apple-${variant}`}>
    <svg viewBox="0 0 120 40" role="img" aria-label="Download on the App Store" xmlns="http://www.w3.org/2000/svg">
      <rect width="120" height="40" rx="8" fill="#000"></rect>
      <path d="M24.77 20.3c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.71-3.18-1.73-1.35-.14-2.64.8-3.32.8-.69 0-1.74-.78-2.86-.76-1.47.02-2.83.86-3.58 2.16-1.54 2.67-.39 6.6 1.09 8.76.73 1.06 1.59 2.24 2.72 2.2 1.1-.05 1.51-.71 2.84-.71 1.32 0 1.7.71 2.85.69 1.18-.02 1.92-1.07 2.64-2.13.83-1.22 1.18-2.41 1.19-2.47-.03-.01-2.28-.87-2.3-3.45zm-2.18-6.34c.6-.73 1.01-1.74.9-2.76-.87.04-1.93.58-2.55 1.3-.55.64-1.04 1.67-.91 2.65.97.08 1.96-.49 2.56-1.19z" fill="#fff"></path>
      <text x="36" y="16" fill="#fff" font-family="Inter,Arial,sans-serif" font-size="6.5" font-weight="400">Download on the</text>
      <text x="36" y="29" fill="#fff" font-family="Inter,Arial,sans-serif" font-size="13" font-weight="600">App Store</text>
    </svg>
  </a>
  <a href="#" class="badge-link" aria-label="Get it on Google Play" rel="noopener"
     data-analytics={`store-google-${variant}`}>
    <svg viewBox="0 0 135 40" role="img" aria-label="Get it on Google Play" xmlns="http://www.w3.org/2000/svg">
      <rect width="135" height="40" rx="8" fill="#000"></rect>
      <polygon points="13,9 13,31 24.5,20" fill="#00D0FF"></polygon>
      <polygon points="13,9 24.5,20 30,14.7 16.2,7" fill="#00F076"></polygon>
      <polygon points="24.5,20 30,25.3 16.2,33 13,31" fill="#FF3A44"></polygon>
      <polygon points="30,14.7 24.5,20 30,25.3 34,20" fill="#FFC900"></polygon>
      <text x="42" y="16" fill="#fff" font-family="Inter,Arial,sans-serif" font-size="6" font-weight="400" letter-spacing="0.5">GET IT ON</text>
      <text x="42" y="29" fill="#fff" font-family="Inter,Arial,sans-serif" font-size="13" font-weight="600">Google Play</text>
    </svg>
  </a>
</div>
